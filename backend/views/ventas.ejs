<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial de ventas - Autoservicio NBA</title>
    <link rel="stylesheet" href="/tienda/estilos.css">
    <script src="/tienda/tema.js" defer></script>
</head>
<body class="pagina-ventas">
    <main>
        <header>
            <h1>Autoservicio NBA</h1>
            <nav>
                <a href="/admin">Volver al panel</a>
            </nav>

            <button id="cambiar-tema" type="button" aria-pressed="false">
                Activar modo oscuro
            </button>
        </header>

<main>
    <h2>Historial de ventas</h2>

        <% if (ventas.length === 0) { %>
            <p>Todavia no hay ventas registradas.</p>
        <% } %>

        <% ventas.forEach(function (venta) { %>
            <section class="venta">
                <h3>Compra #<%= venta.id %> — <%= venta.nombreCliente %></h3>
                <p><%= venta.fecha.toLocaleString('es-AR', {
                    timeZone: 'America/Argentina/Buenos_Aires'
                }) %></p>

                <ul>
                    <% venta.Productos.forEach(function (producto) { %>
                        <li>
                            <%= producto.nombre %>:
                            <%= producto.DetalleVenta.cantidad %> ×
                            <%= moneda.format(producto.DetalleVenta.precioUnitario / 100) %>
                        </li>
                    <% }); %>
                </ul>

                <p>Total: <strong><%= moneda.format(venta.total / 100) %></strong></p>
            </section>
        <% }); %>
    </main>
</body>
</html>