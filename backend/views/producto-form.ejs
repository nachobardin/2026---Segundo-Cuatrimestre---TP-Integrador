<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= producto ? 'Editar producto' : 'Agregar producto' %> - Autoservicio NBA</title>
</head>
<body>
    <header>
        <h1>Autoservicio NBA</h1>
        <nav>
            <a href="/admin">Volver al panel</a>
        </nav>
    </header>

    <main>
        <h2><%= producto ? 'Editar producto' : 'Agregar producto' %></h2>

        <!-- Usamos el mismo formulario para agregar y editar. -->
        <form action="<%= producto ? '/admin/productos/' + producto.id + '/editar' : '/admin/productos' %>" method="post" enctype="multipart/form-data">

            <div>
                <label for="nombre">Nombre</label>
                <input id="nombre" name="nombre" type="text" value="<%= producto ? producto.nombre : '' %>" required>
            </div>

            <div>
                <label for="categoria">Categoría</label>
                <select id="categoria" name="categoria" required>
                    <option value="">Elegí una categoría</option>
                    <option value="Camisetas" <%= producto && producto.categoria === 'Camisetas' ? 'selected' : '' %>>Camisetas</option>
                    <option value="Zapatillas" <%= producto && producto.categoria === 'Zapatillas' ? 'selected' : '' %>>Zapatillas</option>
                </select>
            </div>

            <div>
                <label for="precio">Precio</label>
                <input id="precio" name="precio" type="number" min="0.01" step="0.01" value="<%= producto ? producto.precio : '' %>" required>
            </div>

            <div>
                <label for="imagen">Imagen</label>
                <input id="imagen" name="imagen" type="file" accept="image/jpeg,image/png,image/webp" <%= producto ? '' : 'required' %>>
                <% if (producto) { %>
                    <p>Si no elegis otra imagen, se conserva la actual</p>
                <% } %>
            </div>

            <button type="submit"><%= producto ? 'Guardar cambios' : 'Guardar producto' %></button>
        </form>
    </main>
</body>
</html>