<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel - Autoservicio NBA</title>
</head>
<body>
    <header>
        <h1>Autoservicio NBA</h1>
        <nav>
            <a href="/tienda/">Volver a la tienda</a>
        </nav>
    </header>

    <main>

        <h2>Panel del administrador</h2>
        <a href="/admin/productos/nuevo">Agregar producto</a>
        <p>Ingresaste como <%= usuario.correo %></p>

        <h3>Productos</h3>

        <!-- mostramos un aviso si no hay productos -->
        <% if (productos.length === 0) { %>
            <p>No hay productos cargados.</p>
        <% } else { %>
            <ul>
                <% productos.forEach(function(producto) { %>
                    <li>
                        <strong><%= producto.nombre %></strong>
                        - <%=producto.categoria %>
                        - $<%=producto.precio %>
                        - <%=producto.activo ? 'Activo' : 'Inactivo' %>
                        <a href="/admin/productos/<%= producto.id %>/editar">Editar</a>

                        <button type="button" class="cambiar-estado"
                                data-url="/admin/productos/<%= producto.id %>/estado"
                                data-activo="<%= producto.activo ? 'false' : 'true' %>">
                                <%= producto.activo ? 'Desactivar' : 'Activar' %>
                        </button>
                    </li>
                <% }); %>
            </ul>
        <% } %>
        
        <form action="/logout" method="post">
            <button type="submit">Cerrar sesion</button>
        </form>
        
    </main>
    <dialog id="confirmar-estado" aria-labelledby="pregunta-estado">
    <p id="pregunta-estado"></p>

    <form id="form-estado" method="post">
        <input type="hidden" name="activo" id="nuevo-estado">
        <button type="submit">Confirmar</button>
    </form>

    <form method="dialog">
        <button type="submit">Cancelar</button>
    </form>
</dialog>

<script>

    const modalEstado = document.getElementById('confirmar-estado');
    const formEstado = document.getElementById('form-estado');
    const nuevoEstado = document.getElementById('nuevo-estado');
    const preguntaEstado = document.getElementById('pregunta-estado');

    //prepara el formulario para el producto a transformar
    document.querySelectorAll('.cambiar-estado').forEach(function (boton) {
        boton.addEventListener('click', function () {
            formEstado.action = boton.dataset.url;
            nuevoEstado.value = boton.dataset.activo;
            preguntaEstado.textContent = boton.dataset.activo === 'true'
                ? '¿Queres activar este producto?'
                : '¿Queres desactivar este producto?';

            modalEstado.showModal();
        });
    });
    
</script>
</body>
</html>